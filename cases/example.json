{
  "version": 1,
  "format": "adbcase.case",
  "name": "车机_空调面板_冒烟",
  "tags": [
    "hvac",
    "smoke",
    "demo"
  ],
  "device": {
    "model": "DemoHeadUnit",
    "serial": "",
    "size": [
      1920,
      720
    ],
    "rotation": 0,
    "touch_abs": [
      1919,
      719
    ],
    "abs_source": "getevent",
    "inputs": []
  },
  "params": {
    "boot_wait": "1500",
    "target_temp": "24"
  },
  "steps": [
    {
      "action": "launch",
      "package": "com.demo.hvac",
      "at_ms": 0,
      "until": {
        "text": "空调",
        "timeout_ms": 5000,
        "interval_ms": 250,
        "retry": 1
      },
      "desc": "启动空调应用并等界面出现（条件等待，不靠固定延时）"
    },
    {
      "action": "wait",
      "ms": "${boot_wait}",
      "at_ms": 1500,
      "desc": "等待界面稳定"
    },
    {
      "action": "tap",
      "at": [
        0.235,
        0.42
      ],
      "at_ms": 2100,
      "on_fail": "retry",
      "desc": "点击空调面板入口（偶发失败自动重试）"
    },
    {
      "action": "wait_until",
      "at_ms": 2700,
      "until": {
        "text": "温度",
        "timeout_ms": 3000,
        "interval_ms": 200
      },
      "desc": "等面板加载出温度文字"
    },
    {
      "action": "swipe",
      "from": [
        0.5,
        0.72
      ],
      "to": [
        0.5,
        0.3
      ],
      "duration_ms": 320,
      "at_ms": 3000,
      "desc": "上滑温度列表"
    },
    {
      "action": "repeat",
      "count": 2,
      "at_ms": 3400,
      "desc": "连点两次加号",
      "steps": [
        {
          "action": "tap",
          "at": [
            0.812,
            0.35
          ],
          "at_ms": 3400,
          "desc": "温度 +1"
        },
        {
          "action": "wait",
          "ms": 200,
          "at_ms": 3600,
          "desc": "间隔"
        }
      ]
    },
    {
      "action": "assert_text",
      "text": "${target_temp}",
      "at_ms": 4000,
      "desc": "校验目标温度出现"
    },
    {
      "action": "assert_activity",
      "contains": "com.demo.hvac",
      "at_ms": 4100,
      "desc": "校验仍停留在空调应用"
    },
    {
      "action": "screenshot",
      "path": "hvac_result.png",
      "at_ms": 4200,
      "desc": "留存结果截图"
    },
    {
      "action": "keyevent",
      "key": "KEYCODE_BACK",
      "at_ms": 4300,
      "desc": "返回"
    },
    {
      "action": "comment",
      "desc": "这一行不执行，仅作说明"
    }
  ]
}
